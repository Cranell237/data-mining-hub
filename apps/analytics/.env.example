# Copia este archivo como .env (nunca lo subas a git: está en .gitignore).
# Solo es necesario si ejecutas Python FUERA del contenedor; dentro de
# Docker, docker-compose.yml ya inyecta DB_URL al entorno.

# postgresql+psycopg2://<usuario>:<password>@<host>:<puerto>/<base>
DB_URL=postgresql+psycopg2://USUARIO:PASSWORD@localhost:5437/enterprise_warehouse
